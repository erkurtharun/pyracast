{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --no-build --quiet python -c \"import runpy,subprocess; runpy.run_path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip()+'/.agents/hooks.py',run_name='__main__')\" post-tool",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Read|read_file|read_text_file|read_multiple_files|get_file_text_by_path|view_image|mcp__.*__(read_file|read_text_file|read_multiple_files|get_file_text_by_path|execute_tool))$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --no-build --quiet python -c \"import runpy,subprocess; runpy.run_path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip()+'/.agents/hooks.py',run_name='__main__')\" pre-read",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell|shell|local_shell|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --no-build --quiet python -c \"import runpy,subprocess; runpy.run_path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip()+'/.agents/hooks.py',run_name='__main__')\" pre-shell",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
