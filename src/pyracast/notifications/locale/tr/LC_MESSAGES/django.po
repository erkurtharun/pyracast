"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "A supported reminder language is required."
msgstr "Desteklenen bir hatırlatıcı dili seçilmelidir."

#, python-format
msgid "Forecast for %(plant)s"
msgstr "%(plant)s için tahmin"

msgid "%(plant)s: forecast unavailable for %(date)s"
msgstr "%(plant)s: %(date)s tahmini kullanılamıyor"

#, python-format
msgid ""
"Tomorrow's saved forecast for %(plant)s could not be prepared. No forecast energy "
"total is available.\n"
"Scheduled reminder: %(time)s (%(zone)s)\n"
"Check the plant page for collection status: %(url)s"
msgstr ""
"%(plant)s için yarının kayıtlı tahmini hazırlanamadı. Tahmini enerji toplamı "
"mevcut değil.\n"
"Planlanan hatırlatma: %(time)s (%(zone)s)\n"
"Veri toplama durumunu santral sayfasından kontrol edin: %(url)s"

msgid ""
"You receive this email because an administrator of %(workspace)s added your "
"address to the reminders of %(plant)s. To stop them, ask that administrator to "
"remove your address."
msgstr ""
"Bu e-postayı, %(workspace)s yöneticilerinden biri adresinizi %(plant)s "
"hatırlatmalarına eklediği için alıyorsunuz. Durdurmak için o yöneticiden "
"adresinizi çıkarmasını isteyin."

msgid "ambiguous_zero_power"
msgstr "sıfır güçten ışınım belirlenemiyor"

msgid "incomplete_day"
msgstr "eksik gün"

msgid "missing_power"
msgstr "güç verisi eksik"

msgid "negative_power"
msgstr "negatif güç"

msgid "night_power_conflict"
msgstr "gece güç verisi çelişkisi"

msgid "nonfinite_irradiance"
msgstr "ışınım değeri sonlu değil"

msgid "nonfinite_power"
msgstr "güç değeri sonlu değil"

msgid "partial_sunlight"
msgstr "kısmi gün ışığı"

msgid "prorated_interval_mean"
msgstr "orantılanmış aralık ortalaması"

msgid "sunlight_unknown"
msgstr "gün ışığı bilinmiyor"

msgid "synthetic_fixture"
msgstr "sentetik örnek veri"

msgid "unavailable"
msgstr "mevcut değil"

msgid "uniform_mean_proration"
msgstr "sabit ortalama ile orantılama"

msgid "unvalidated"
msgstr "doğrulanmamış"

msgid "Forecast"
msgstr "Tahmin"

msgid "Updated"
msgstr "Güncelleme"

msgid "Unavailable"
msgstr "Veri yok"

msgid "Date"
msgstr "Tarih"

msgid "Coverage"
msgstr "Kapsam"

msgid "Outage coverage"
msgstr "Kesinti senaryosu kapsamı"

msgid "Status"
msgstr "Durum"

msgid "From"
msgstr "Başlangıç"

msgid "To"
msgstr "Bitiş"

msgid "From UTC offset"
msgstr "Başlangıç UTC farkı"

msgid "To UTC offset"
msgstr "Bitiş UTC farkı"

#, python-format
msgid "Normal operation (%(unit)s)"
msgstr "Normal çalışma (%(unit)s)"

#, python-format
msgid "Forecast (%(unit)s)"
msgstr "Tahmin (%(unit)s)"

#, python-format
msgid "With reported outage (%(unit)s)"
msgstr "Kayıtlı kesintiyle (%(unit)s)"

msgid "Normal operation"
msgstr "Normal çalışma"

msgid "With reported outage"
msgstr "Kayıtlı kesintiyle"

msgid "Partial estimate"
msgstr "Tahmin kısmi"

msgid "Outage partial"
msgstr "Kesinti senaryosu kısmi"

msgid "Estimate unavailable"
msgstr "Tahmin yok"

msgid "Irradiance estimate, not plant electricity."
msgstr "Işınım tahminidir; santral üretimi değildir."

msgid "Forecast data is over 24 hours old."
msgstr "Tahmin verisi 24 saatten eski."

msgid "Using the last saved forecast."
msgstr "Son kayıtlı tahmin kullanılıyor."

msgid "The outage scenario follows the recorded outage times and limits."
msgstr ""
"Kesinti senaryosu, kayıtlı kesinti saatlerini ve kapasite sınırlarını esas "
"alır."

#, python-format
msgid "Partial: %(energy)s %(unit)s (%(coverage)s%% coverage)"
msgstr "Kısmi: %(energy)s %(unit)s (%(coverage)s%% kapsam)"

#, python-format
msgid "Updated: %(time)s (%(timezone)s)"
msgstr "Güncelleme: %(time)s (%(timezone)s)"

msgid "Tomorrow's forecast is unavailable."
msgstr "Yarının tahmini mevcut değil."

#, python-format
msgid "%(plant)s — forecast for %(date)s"
msgstr "%(plant)s — %(date)s tahmini"

msgid "Interval forecasts are in the attached Excel file."
msgstr "Aralık tahminleri ekteki Excel dosyasındadır."

msgid "View forecasts"
msgstr "Tahminleri aç"

msgid "Outage impact unknown"
msgstr "Kesintinin etkisi belirsiz"

msgid ""
"Outage impact is unknown. Update the outage capacity to get an estimate."
msgstr ""
"Kesintinin etkisi belirsiz. Tahmin için kesinti kapasitesini güncelleyin."

msgid "Outage unavailable"
msgstr "Kesinti tahmini yok"

msgid "Estimated actuals"
msgstr "Gerçekleşen tahmini"

msgid "Estimated + forecast"
msgstr "Gerçekleşen tahmini + öngörü"

msgid "Estimate (%(unit)s)"
msgstr "Tahmin (%(unit)s)"

msgid "Source"
msgstr "Kaynak"

msgid "This plant allows at most %(limit)s delivery times a day."
msgstr "Bu santral günde en fazla %(limit)s gönderim saatine izin verir."

msgid "You receive this email because of your role in %(workspace)s on Pyracast."
msgstr ""
"Bu e-postayı Pyracast'teki %(workspace)s çalışma alanındaki rolünüz nedeniyle "
"alıyorsunuz."

msgid "%(plant)s is approved"
msgstr "%(plant)s onaylandı"

msgid ""
"Pyracast support approved %(plant)s in %(workspace)s on %(time)s (%(zone)s). "
"Forecasts start with the next collection."
msgstr ""
"Pyracast desteği %(workspace)s çalışma alanındaki %(plant)s santralini %(time)s "
"(%(zone)s) tarihinde onayladı. Tahminler bir sonraki veri toplamayla başlar."

msgid "%(plant)s was not approved"
msgstr "%(plant)s onaylanmadı"

msgid ""
"Pyracast support did not approve %(plant)s in %(workspace)s on %(time)s "
"(%(zone)s). Correct the plant's details and resubmit it for review."
msgstr ""
"Pyracast desteği %(workspace)s çalışma alanındaki %(plant)s santralini %(time)s "
"(%(zone)s) tarihinde onaylamadı. Santralin bilgilerini düzeltip yeniden "
"incelemeye gönderin."

msgid "%(plant)s is suspended"
msgstr "%(plant)s askıya alındı"

msgid ""
"Pyracast support suspended %(plant)s in %(workspace)s on %(time)s (%(zone)s). "
"Forecast collection and reminders are paused."
msgstr ""
"Pyracast desteği %(workspace)s çalışma alanındaki %(plant)s santralini %(time)s "
"(%(zone)s) tarihinde askıya aldı. Tahmin toplama ve hatırlatmalar duraklatıldı."

msgid "Open plant"
msgstr "Santrali aç"

msgid "You now administer %(workspace)s"
msgstr "Artık %(workspace)s çalışma alanının yöneticisisiniz"

msgid ""
"Pyracast support made you the administrator of %(workspace)s. Automatic "
"calibration was turned off for its plants and open invitations were cancelled; "
"review the members and invite again where needed."
msgstr ""
"Pyracast desteği sizi %(workspace)s çalışma alanının yöneticisi yaptı. "
"Santrallerin otomatik kalibrasyonu kapatıldı ve açık davetler iptal edildi; "
"üyeleri gözden geçirip gerekirse yeniden davet edin."

msgid "Open members"
msgstr "Üyeleri aç"

msgid "Your administrator role in %(workspace)s moved"
msgstr "%(workspace)s yönetici rolünüz devredildi"

msgid ""
"Pyracast support moved the administrator role of %(workspace)s to another "
"member. You keep read-only access."
msgstr ""
"Pyracast desteği %(workspace)s yönetici rolünü başka bir üyeye devretti. Salt "
"okunur erişiminiz sürüyor."

msgid "Open workspace"
msgstr "Çalışma alanını aç"

msgid "%(plant)s will be deleted permanently"
msgstr "%(plant)s kalıcı olarak silinecek"

msgid ""
"%(plant)s has been in the recycle bin of %(workspace)s since %(trashed)s. It will "
"be deleted permanently on %(time)s (%(zone)s) with its forecasts and history. "
"Restore it before then to keep it."
msgstr ""
"%(plant)s, %(trashed)s tarihinden beri %(workspace)s geri dönüşüm kutusunda. "
"%(time)s (%(zone)s) tarihinde tahminleri ve geçmişiyle birlikte kalıcı olarak "
"silinecek. Saklamak için bundan önce geri yükleyin."

msgid "Open recycle bin"
msgstr "Geri dönüşüm kutusunu aç"
