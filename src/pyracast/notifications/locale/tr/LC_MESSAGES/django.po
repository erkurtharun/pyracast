msgid "A supported reminder language is required."
msgstr "Desteklenen bir hatırlatıcı dili seçilmelidir."

#, python-format
msgid ""
"Forecast email of %(plant)s in %(workspace)s. The workspace's administrators "
"manage who receives it."
msgstr ""
"%(workspace)s çalışma alanındaki %(plant)s santralinin tahmin e-postası. "
"Alıcıları çalışma alanı yöneticileri belirler."

msgctxt "forecast mail day"
msgid "D j M Y"
msgstr "j F Y l"

msgctxt "forecast mail subject day"
msgid "D j M"
msgstr "j F l"

msgctxt "forecast mail sentence day"
msgid "l j F Y"
msgstr "j F Y l"

msgctxt "forecast mail time"
msgid "j M Y, H:i"
msgstr "j F Y, H:i"

msgctxt "Excel date format"
msgid "dd mmm yyyy"
msgstr "dd.mm.yyyy"

#, python-format
msgid "%(subject)s (%(clock)s edition)"
msgstr "%(subject)s (%(clock)s gönderimi)"

#, python-format
msgid "%(plant)s: forecast for %(date)s"
msgstr "%(plant)s: %(date)s üretim tahmini"

#, python-format
msgid "%(plant)s: irradiance forecast for %(date)s"
msgstr "%(plant)s: %(date)s ışınım tahmini"

#, python-format
msgid "%(plant)s: forecast for %(date)s is incomplete"
msgstr "%(plant)s: %(date)s tahmini eksik"

#, python-format
msgid "%(plant)s: no forecast for %(date)s"
msgstr "%(plant)s: %(date)s tahmini hazırlanamadı"

msgid "Generation forecast"
msgstr "Üretim tahmini"

msgid "Solar irradiance forecast (GHI), not electricity generation"
msgstr "Güneş ışınımı tahmini (GHI); elektrik üretimi değildir"

#, python-format
msgid "%(plant)s: generation forecast"
msgstr "%(plant)s: üretim tahmini"

#, python-format
msgid "%(plant)s: solar irradiance forecast (GHI), not electricity generation"
msgstr "%(plant)s: güneş ışınımı tahmini (GHI); elektrik üretimi değildir"

msgid "Tomorrow"
msgstr "Yarın"

msgid "Today"
msgstr "Bugün"

#, python-format
msgid "Includes the recorded outage. Without it: %(energy)s."
msgstr "Kayıtlı kesinti dahil. Kesinti olmasaydı: %(energy)s."

msgid "The recorded outage is not included in this figure."
msgstr "Kayıtlı kesinti bu rakama dahil değildir."

msgid "Enter the capacity still in service in the outage record to include it."
msgstr "Dahil edilmesi için kesinti kaydına devrede kalan gücü girin."

msgid "Data is missing for some hours, so no daily total is given."
msgstr "Bazı saatlerin verisi eksik olduğundan günlük toplam verilmedi."

msgid "No forecast data for this day."
msgstr "Bu gün için tahmin verisi yok."

#, python-format
msgid "Forecast data: %(time)s (%(offset)s)"
msgstr "Tahmin verisi: %(time)s (%(offset)s)"

msgid "Newer forecast data was not available."
msgstr "Daha yeni tahmin verisi alınamadı."

msgid "Hourly values are in the attached Excel file."
msgstr "Saatlik değerler ekteki Excel dosyasındadır."

msgid "Interval values are in the attached Excel file."
msgstr "Aralık değerleri ekteki Excel dosyasındadır."

msgid "Open forecast in Pyracast"
msgstr "Tahmini Pyracast'te aç"

#, python-format
msgid "The forecast for %(date)s could not be prepared. This email contains no figures."
msgstr "%(date)s için üretim tahmini hazırlanamadı. Bu e-postada rakam yoktur."

msgid "Open plant in Pyracast"
msgstr "Santrali Pyracast'te aç"

msgctxt "workbook sheet"
msgid "Forecast"
msgstr "Tahmin"

msgctxt "workbook sheet"
msgid "Irradiance"
msgstr "Işınım"

msgid "Generation forecast · Pyracast"
msgstr "Üretim tahmini · Pyracast"

msgid "Solar irradiance forecast (GHI) · Pyracast"
msgstr "Güneş ışınımı tahmini (GHI) · Pyracast"

msgid "Forecast data"
msgstr "Tahmin verisi"

msgid "Time zone"
msgstr "Saat dilimi"

msgid "Unit"
msgstr "Birim"

msgid "Daily totals"
msgstr "Günlük toplamlar"

msgid "Date"
msgstr "Tarih"

msgid "Forecast (MWh)"
msgstr "Tahmin (MWh)"

msgid "Irradiance (kWh/m²)"
msgstr "Işınım (kWh/m²)"

msgid "Without outage (MWh)"
msgstr "Kesinti olmadan (MWh)"

msgid "The Forecast column includes the recorded outage."
msgstr "Tahmin sütunu kayıtlı kesintiyi içerir."

#, python-format
msgid "%(date)s: the recorded outage is not included."
msgstr "%(date)s: kayıtlı kesinti dahil değildir."

#, python-format
msgid "%(date)s: data is missing for some hours; no daily total."
msgstr "%(date)s: bazı saatlerin verisi eksik; günlük toplam verilmedi."

#, python-format
msgid "%(date)s: no forecast data."
msgstr "%(date)s: tahmin verisi yok."

msgid "Hourly values"
msgstr "Saatlik değerler"

msgid "Interval values"
msgstr "Aralık değerleri"

msgid "From"
msgstr "Başlangıç"

msgid "To"
msgstr "Bitiş"

msgid "Estimated actuals"
msgstr "Gerçekleşen tahmini"

msgid "This plant allows at most %(limit)s delivery times a day."
msgstr "Bu santral günde en fazla %(limit)s gönderim saatine izin verir."

msgid "You receive this email because of your role in %(workspace)s."
msgstr "Bu e-postayı %(workspace)s çalışma alanındaki rolünüz nedeniyle alıyorsunuz."

msgid "%(plant)s is approved"
msgstr "%(plant)s onaylandı"

msgid "Pyracast approved the plant."
msgstr "Pyracast santrali onayladı."

msgid "Approved at"
msgstr "Onay zamanı"

msgid "%(plant)s was not approved"
msgstr "%(plant)s onaylanmadı"

msgid "Pyracast did not approve the plant."
msgstr "Pyracast santrali onaylamadı."

msgid "Decided at"
msgstr "Karar zamanı"

msgid "Correct the details and send the plant for approval again."
msgstr "İstenen bilgileri düzeltip santrali yeniden onaya gönderin."

msgid "%(plant)s is suspended"
msgstr "%(plant)s askıya alındı"

msgid "Pyracast suspended the plant. Forecasts and forecast emails for it are stopped."
msgstr ""
"Pyracast santrali askıya aldı. Santralin tahminleri ve tahmin e-postaları "
"durduruldu."

msgid "Suspended at"
msgstr "Askıya alma zamanı"

msgid "Open plant"
msgstr "Santrali aç"

msgid "You are now the workspace administrator of %(workspace)s"
msgstr "Artık %(workspace)s çalışma alanının yöneticisisiniz"

msgid ""
"Pyracast made you the workspace administrator and withdrew the pending "
"invitations. Check the members and invite again where needed."
msgstr ""
"Pyracast sizi çalışma alanı yöneticisi yaptı ve bekleyen davetleri geri "
"çekti. Üyeleri kontrol edip gerekirse yeniden davet edin."

msgid "Open members"
msgstr "Üyeleri aç"

msgid "You are no longer the workspace administrator of %(workspace)s"
msgstr "Artık %(workspace)s çalışma alanının yöneticisi değilsiniz"

msgid ""
"Pyracast handed the workspace administrator role over to another member. You "
"are now a member of the workspace."
msgstr ""
"Pyracast çalışma alanı yöneticisi rolünü başka bir üyeye devretti. Artık "
"çalışma alanında üyesiniz."

msgid "Open workspace"
msgstr "Çalışma alanını aç"

msgid "%(plant)s will be deleted permanently"
msgstr "%(plant)s kalıcı olarak silinecek"

msgid "The plant is in the recycle bin."
msgstr "Santral geri dönüşüm kutusunda."

msgid "Deleted at"
msgstr "Silindiği zaman"

msgid "Deleted permanently at"
msgstr "Kalıcı olarak silineceği zaman"

msgid "Restore the plant before then to keep it with its forecasts and history."
msgstr ""
"Santrali tahminleri ve geçmişiyle birlikte saklamak için bu zamandan önce geri "
"yükleyin."

msgid "Open recycle bin"
msgstr "Geri dönüşüm kutusunu aç"

msgid "forecast email settings"
msgstr "tahmin e-postası ayarları"
