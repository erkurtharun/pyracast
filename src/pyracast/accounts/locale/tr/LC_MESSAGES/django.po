#
msgid ""
msgstr ""
"Language: tr\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Continue to sign in"
msgstr "Oturum açmaya devam et"

msgid "Workspace administrator required."
msgstr "Çalışma alanı yöneticisi yetkisi gereklidir."

msgid "The workspace administrator cannot be removed."
msgstr "Çalışma alanı yöneticisi çıkarılamaz."

msgid "The workspace administrator changed. Reload before saving."
msgstr "Çalışma alanı yöneticisi değişti. Kaydetmeden önce sayfayı yenileyin."

msgid "Choose an active member of this workspace."
msgstr "Bu çalışma alanının etkin bir üyesini seçin."

msgid "The invitation is invalid or expired."
msgstr "Davet geçersiz veya süresi dolmuş."

msgid "This account already belongs to the workspace."
msgstr "Bu hesap zaten çalışma alanının üyesi."

msgid "Verify the invited email address before accepting."
msgstr "Daveti kabul etmeden önce davet edilen e-posta adresini doğrulayın."

msgid "Pyracast workspace invitation"
msgstr "Pyracast çalışma alanı daveti"

msgid "This workspace name is already in use."
msgstr "Bu çalışma alanı adı zaten kullanılıyor."

msgid "A workspace name is required."
msgstr "Çalışma alanı adı gereklidir."

msgid "Verify an authenticator before managing two-factor authentication."
msgstr ""
"İki adımlı doğrulamayı yönetmeden önce doğrulayıcı uygulamanızla kimliğinizi"
" doğrulayın."

msgid "Or copy this link into your browser:"
msgstr "Ya da bu bağlantıyı tarayıcınıza kopyalayın:"

msgid "Verify your email"
msgstr "E-posta adresinizi doğrulayın"

msgid "Enter this code in the Pyracast window where you requested it."
msgstr "Bu kodu, isteği başlattığınız Pyracast penceresine girin."

#, python-format
msgid "This code expires in %(minutes)s minutes. Do not share it."
msgstr "Bu kod %(minutes)s dakika içinde sona erer. Kodu paylaşmayın."

msgid "Confirm your email address to continue to Pyracast."
msgstr "Pyracast'e devam etmek için e-posta adresinizi doğrulayın."

msgid "If you did not request this, you can ignore this email."
msgstr "Bu isteği siz yapmadıysanız bu e-postayı yok sayabilirsiniz."

msgid "Verify email"
msgstr "E-postayı doğrula"

msgid "Reset your password"
msgstr "Parolanızı sıfırlayın"

#, python-format
msgid "You are invited to %(workspace)s."
msgstr "%(workspace)s çalışma alanına davet edildiniz."

#, python-format
msgid ""
"Sign in or create an account with %(email)s, then verify your email to "
"accept the invitation."
msgstr ""
"%(email)s adresiyle giriş yapın veya hesap oluşturun, ardından daveti kabul "
"etmek için e-posta adresinizi doğrulayın."

msgid ""
"This invitation expires in seven days and grants read-only workspace access."
msgstr ""
"Bu davet yedi gün sonra sona erer ve çalışma alanına salt okunur erişim "
"sağlar."

msgid "Workspace invitation"
msgstr "Çalışma alanı daveti"

msgid "Review invitation"
msgstr "Daveti incele"

msgid "Use this link to choose a new password for your Pyracast account."
msgstr ""
"Pyracast hesabınıza yeni bir parola belirlemek için bu bağlantıyı kullanın."

msgid "Reset password"
msgstr "Parolayı sıfırla"

msgid "Confirm your identity"
msgstr "Kimliğinizi doğrulayın"

msgid "A reason of 1 to 500 characters is required."
msgstr "1 ile 500 karakter arasında bir gerekçe gereklidir."

msgid "Use a new request key for changed input."
msgstr "Değiştirilen bilgiler için yeni bir talep anahtarı kullanın."

msgid "Resolve or withdraw pending requests before submitting more."
msgstr ""
"Yeni talep göndermeden önce bekleyen talepleri sonuçlandırın veya geri "
"çekin."

msgid "Submit 1 to 100 production intervals."
msgstr "1 ile 100 arasında üretim aralığı gönderin."

msgid "The request already has a different outcome."
msgstr "Talep zaten farklı bir sonuçla kapatıldı."

msgid "The review context changed. Refresh and review again."
msgstr "İnceleme verileri değişti. Sayfayı yenileyip yeniden inceleyin."

msgid "The incident request target is incomplete."
msgstr "Kesinti talebinin hedef bilgileri eksik."

msgid "Unknown incident request action."
msgstr "Bilinmeyen kesinti talebi işlemi."

msgid ""
"Incident identity and expected revision are required for existing incidents."
msgstr ""
"Mevcut kesintiler için kesinti kimliği ve beklenen revizyon gereklidir."

msgid "Unsupported incident request fields."
msgstr "Desteklenmeyen kesinti talebi alanları."

msgid "Request numbers must be finite."
msgstr "Talepteki sayılar sonlu olmalıdır."

msgid "Incident values are required for create and update."
msgstr "Oluşturma ve güncelleme için kesinti bilgileri gereklidir."

msgid "The plant configuration changed. Submit a new request."
msgstr "Santral yapılandırması değişti. Yeni bir talep gönderin."

msgid "Workspace members submit requests; administrators edit directly."
msgstr ""
"Çalışma alanı üyeleri talep gönderir; yöneticiler doğrudan düzenleme yapar."
