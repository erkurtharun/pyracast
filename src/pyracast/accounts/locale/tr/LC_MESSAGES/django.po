#
msgid ""
msgstr ""
"Language: tr\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Continue to sign in"
msgstr "Oturum açmaya devam et"

msgid "Only the workspace administrator can do this."
msgstr "Bunu yalnızca çalışma alanı yöneticisi yapabilir."

msgid "The workspace administrator cannot be removed."
msgstr "Çalışma alanı yöneticisi çıkarılamaz."

msgid "The workspace administrator changed. Reload the page and try again."
msgstr "Çalışma alanı yöneticisi değişti. Sayfayı yenileyip tekrar deneyin."

msgid "Choose an active member of this workspace."
msgstr "Bu çalışma alanının etkin bir üyesini seçin."

msgid ""
"This invitation is no longer valid. Ask the workspace administrator for a "
"new one."
msgstr ""
"Bu davet artık geçerli değil. Çalışma alanı yöneticisinden yeni bir davet "
"isteyin."

msgid "This account already belongs to the workspace."
msgstr "Bu hesap zaten çalışma alanının üyesi."

msgid "Verify the invited email address before accepting."
msgstr "Daveti kabul etmeden önce davet edilen e-posta adresini doğrulayın."

msgid "Pyracast workspace invitation"
msgstr "Pyracast çalışma alanı daveti"

msgid "The company name contains an invisible character. Type the name again."
msgstr "Şirket adında görünmeyen bir karakter var. Adı yeniden yazın."

msgid "Enter the company name without a web or email address."
msgstr "Şirket adını web veya e-posta adresi olmadan girin."

msgid "Enter the company name."
msgstr "Şirket adını girin."

msgid "Or copy this link into your browser:"
msgstr "Ya da bu bağlantıyı tarayıcınıza kopyalayın:"

msgid "Verify your email"
msgstr "E-posta adresinizi doğrulayın"

msgid "Enter this code in the Pyracast window where you requested it."
msgstr "Bu kodu, isteği başlattığınız Pyracast penceresine girin."

msgid "Confirm your email address to continue to Pyracast."
msgstr "Pyracast'e devam etmek için e-posta adresinizi doğrulayın."

msgid "If you did not request this, you can ignore this email."
msgstr "Bu isteği siz yapmadıysanız bu e-postayı yok sayabilirsiniz."

msgid "Reset your password"
msgstr "Parolanızı sıfırlayın"

#, python-format
msgid "You are invited to %(workspace)s."
msgstr "%(workspace)s çalışma alanına davet edildiniz."

#, python-format
msgid ""
"Sign in or create an account with %(email)s, then verify your email to "
"accept the invitation."
msgstr ""
"%(email)s adresiyle giriş yapın veya hesap oluşturun, ardından daveti kabul "
"etmek için e-posta adresinizi doğrulayın."

msgid ""
"This invitation expires in seven days and grants read-only workspace access."
msgstr ""
"Bu davet yedi gün sonra sona erer ve çalışma alanına salt okunur erişim "
"sağlar."

msgid "Workspace invitation"
msgstr "Çalışma alanı daveti"

msgid "Review invitation"
msgstr "Daveti incele"

msgid "Reset password"
msgstr "Parolayı sıfırla"

msgid "Confirm your identity"
msgstr "Kimliğinizi doğrulayın"

msgid "Enter a reason of at most 500 characters."
msgstr "En fazla 500 karakterlik bir gerekçe girin."

msgid ""
"Too many of your change requests are waiting for approval. Withdraw one or "
"wait for a decision before sending another."
msgstr ""
"Onay bekleyen değişiklik talebiniz çok fazla. Yenisini göndermeden önce "
"birini geri çekin veya karar verilmesini bekleyin."

msgid "Send 1 to 100 values in one change request."
msgstr "Bir değişiklik talebinde 1 ile 100 arasında değer gönderin."

msgid "This change request was already approved, rejected or withdrawn."
msgstr "Bu değişiklik talebi zaten onaylandı, reddedildi veya geri çekildi."

msgid ""
"This change request or the plant changed after you opened it. Reload the "
"page and check it again."
msgstr ""
"Bu değişiklik talebi veya santral siz açtıktan sonra değişti. Sayfayı "
"yenileyip yeniden kontrol edin."

msgid ""
"The plant's technical details changed after this change request was sent, so"
" it cannot be approved."
msgstr ""
"Bu değişiklik talebi gönderildikten sonra santralin teknik bilgileri "
"değişti; talep onaylanamaz."

msgid "As the workspace administrator, make this change directly."
msgstr "Çalışma alanı yöneticisi olarak bu değişikliği doğrudan yapın."

msgid ""
"Too many sign-in attempts, or an email code was sent a moment ago. Try again"
" in a few minutes."
msgstr ""
"Çok fazla giriş denemesi yapıldı veya az önce bir e-posta kodu gönderildi. "
"Birkaç dakika sonra tekrar deneyin."

msgid "Your password was changed"
msgstr "Parolanız değiştirildi"

msgid "The password of your Pyracast account was changed."
msgstr "Pyracast hesabınızın parolası değiştirildi."

msgid "A password was set for your account"
msgstr "Hesabınız için parola belirlendi"

msgid "A password was set for your Pyracast account."
msgstr "Pyracast hesabınız için bir parola belirlendi."

msgid "Your password was reset"
msgstr "Parolanız sıfırlandı"

msgid "The password of your Pyracast account was reset."
msgstr "Pyracast hesabınızın parolası sıfırlandı."

msgid "Your email address was changed"
msgstr "E-posta adresiniz değiştirildi"

msgid ""
"Your Pyracast email address changed from %(from_email)s to %(to_email)s."
msgstr ""
"Pyracast e-posta adresiniz %(from_email)s yerine %(to_email)s olarak "
"değişti."

msgid "Your email address was verified"
msgstr "E-posta adresiniz doğrulandı"

msgid "The email address of your Pyracast account was verified."
msgstr "Pyracast hesabınızın e-posta adresi doğrulandı."

msgid "An email address was removed"
msgstr "Bir e-posta adresi kaldırıldı"

msgid "%(deleted_email)s was removed from your Pyracast account."
msgstr "%(deleted_email)s, Pyracast hesabınızdan kaldırıldı."

msgid "Two-factor authentication was turned on"
msgstr "İki adımlı doğrulama açıldı"

msgid ""
"Two-factor authentication with an authenticator app was turned on for your "
"account."
msgstr "Hesabınız için doğrulama uygulamasıyla iki adımlı doğrulama açıldı."

msgid "Two-factor authentication was turned off"
msgstr "İki adımlı doğrulama kapatıldı"

msgid ""
"Two-factor authentication with an authenticator app was turned off for your "
"account."
msgstr ""
"Hesabınız için doğrulama uygulamasıyla iki adımlı doğrulama kapatıldı."

msgid "New recovery codes were generated"
msgstr "Yeni kurtarma kodları oluşturuldu"

msgid ""
"New recovery codes were generated for your account. The previous codes no "
"longer work."
msgstr ""
"Hesabınız için yeni kurtarma kodları oluşturuldu. Önceki kodlar artık "
"geçerli değil."

msgid "A sign-in provider was connected"
msgstr "Bir oturum açma sağlayıcısı bağlandı"

msgid "%(provider)s was connected to your Pyracast account for signing in."
msgstr "%(provider)s, oturum açmak için Pyracast hesabınıza bağlandı."

msgid "A sign-in provider was disconnected"
msgstr "Bir oturum açma sağlayıcısının bağlantısı kaldırıldı"

msgid "%(provider)s was disconnected from your Pyracast account."
msgstr "%(provider)s bağlantısı Pyracast hesabınızdan kaldırıldı."

msgid "Pyracast account not found"
msgstr "Pyracast hesabı bulunamadı"

msgid ""
"Someone tried to use %(email)s with Pyracast, but no account uses this "
"address."
msgstr ""
"Birisi %(email)s adresini Pyracast'te kullanmayı denedi, ancak bu adresi "
"kullanan bir hesap yok."

msgid "Create an account"
msgstr "Hesap oluştur"

msgid "Your Pyracast account already exists"
msgstr "Pyracast hesabınız zaten var"

msgid ""
"Someone tried to create a Pyracast account with %(email)s, which already has"
" one."
msgstr ""
"Birisi %(email)s adresiyle Pyracast hesabı oluşturmayı denedi, ancak bu "
"adresin zaten bir hesabı var."

msgid "%(browser)s on %(system)s"
msgstr "%(system)s üzerinde %(browser)s"

msgid "an unknown device"
msgstr "bilinmeyen bir cihaz"

msgid "Time"
msgstr "Zaman"

msgid "Device"
msgstr "Cihaz"

msgid "IP address"
msgstr "IP adresi"

msgid "If you did not make this change, secure your account now:"
msgstr "Bu değişikliği siz yapmadıysanız hesabınızı hemen güvenceye alın:"

msgid "Secure your account"
msgstr "Hesabınızı güvenceye alın"

msgid "This code expires in %(minutes)s minute. Do not share it."
msgid_plural "This code expires in %(minutes)s minutes. Do not share it."
msgstr[0] "Bu kod %(minutes)s dakika içinde sona erer. Kodu paylaşmayın."
msgstr[1] "Bu kod %(minutes)s dakika içinde sona erer. Kodu paylaşmayın."

msgid ""
"This invitation expires in seven days and makes you the workspace "
"administrator."
msgstr ""
"Bu davet yedi gün sonra sona erer ve sizi çalışma alanının yöneticisi yapar."

msgid "Confirm with your authenticator app to continue."
msgstr "Devam etmek için doğrulama uygulamanızla onaylayın."

msgid "Confirm your password to continue."
msgstr "Devam etmek için şifrenizi onaylayın."

msgid "Confirm with an email code to continue."
msgstr "Devam etmek için e-posta koduyla onaylayın."

msgid "Your second factor was reset"
msgstr "İki adımlı doğrulamanız sıfırlandı"

msgid ""
"An operator removed the second factors of your Pyracast account and ended its"
" sessions."
msgstr ""
"Bir operatör Pyracast hesabınızın iki adımlı doğrulama yöntemlerini kaldırdı "
"ve oturumlarını sonlandırdı."

msgid "Password sign-in is paused"
msgstr "Parolayla oturum açma duraklatıldı"

msgid "After many failed sign-in attempts, password sign-in to your Pyracast account is paused for up to 24 hours. Resetting your password ends the pause."
msgstr "Çok sayıda başarısız oturum açma denemesinden sonra Pyracast hesabınızda parolayla oturum açma en fazla 24 saat duraklatıldı. Parolanızı sıfırlamak duraklatmayı sona erdirir."

msgid "Add at least one send time to turn on the forecast email."
msgstr "Tahmin e-postasını açmak için en az bir gönderim saati ekleyin."

msgid "Use each send time once."
msgstr "Her gönderim saatini bir kez kullanın."

msgid "Add a recipient or turn on All members."
msgstr "Bir alıcı ekleyin veya Tüm üyeler seçeneğini açın."

msgid ""
"The forecast email settings changed in the meantime. Check them and save "
"again."
msgstr ""
"Tahmin e-postası ayarları bu arada değişti. Kontrol edip yeniden kaydedin."

msgid "The recipients changed in the meantime. Check them and save again."
msgstr "Alıcılar bu arada değişti. Kontrol edip yeniden kaydedin."

msgid "The forecast email can be turned on once Pyracast approves the plant."
msgstr "Tahmin e-postası, Pyracast santrali onayladıktan sonra açılabilir."

msgid ""
"No new forecast data is arriving for this plant, so the forecast email "
"cannot be turned on."
msgstr ""
"Bu santral için yeni tahmin verisi gelmiyor; bu nedenle tahmin e-postası "
"açılamıyor."
