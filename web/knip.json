{
    "$schema": "https://unpkg.com/knip@6.45.1/schema.json",
    "entry": [
        "playwright.config.ts",
        "tests/**/*.spec.ts",
        "integration/**/*.spec.ts",
        "production-tests/**/*.spec.ts",
        "testing/coverage-reporter.ts",
        "testing/front.ts",
        "eslint/console-scripts.config.mjs"
    ],
    "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.ts",
        "integration/**/*.ts",
        "production-tests/**/*.ts",
        "testing/**/*.{ts,mjs}",
        "eslint/**/*.mjs"
    ],
    "playwright": false,
    "ignoreBinaries": ["uv"]
}
