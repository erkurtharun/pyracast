{
    "name": "pyracast-web",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=26.13.0"
    },
    "scripts": {
        "dev": "next dev --hostname 127.0.0.1",
        "build": "next build",
        "start": "next start --hostname 127.0.0.1",
        "typecheck": "next typegen && tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "playwright test",
        "api:generate": "openapi-typescript openapi.json -o src/lib/schema.d.ts && prettier --write --ignore-path ../.gitignore openapi.json src/lib/schema.d.ts",
        "check": "npm run check:static && npm test",
        "test:integration": "playwright test --config playwright.integration.config.ts",
        "test:coverage": "node testing/run-coverage.mjs",
        "check:static": "npm run format:check && npm run lint && npm run typecheck && npm run build",
        "check:coverage": "npm run check:static && npm run test:coverage"
    },
    "dependencies": {
        "next": "16.4.6",
        "next-intl": "4.15.1",
        "papaparse": "5.7.0",
        "qrcode.react": "4.2.0",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@eslint/js": "10.0.1",
        "@formatjs/icu-messageformat-parser": "3.5.23",
        "@next/eslint-plugin-next": "16.4.6",
        "@playwright/test": "1.65.0",
        "@types/node": "26.6.6",
        "@types/papaparse": "5.5.2",
        "@types/pngjs": "6.0.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "10.14.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "jsqr": "1.4.0",
        "monocart-coverage-reports": "3.2.1",
        "openapi-typescript": "7.13.0",
        "pngjs": "7.0.0",
        "prettier": "3.9.10",
        "typescript": "5.9.3",
        "typescript-eslint": "8.72.2"
    },
    "overrides": {
        "minimatch@>=7.0.0 <11.0.1": "11.0.5"
    }
}
