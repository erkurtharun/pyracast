project_id = "your-existing-billing-project"
region     = "europe-west1"
zone       = "europe-west1-b"
domain     = "forecast.example.com"
acme_email = "operator@example.com"

operator_members = ["user:operator@example.com"]

# PostgreSQL shares the single application VM; hourly backups live in a private bucket.
machine_type = "e2-medium"
data_disk_gb = 30
