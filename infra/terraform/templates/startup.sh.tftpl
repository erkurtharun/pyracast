#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
trap 'echo "Pyracast boot configuration stopped at line $LINENO; every step after it is unchanged." >&2' ERR

# Runs at every boot: each step changes the host only when what it would write differs.
. /etc/os-release
if [[ $ID != ubuntu || $VERSION_ID != 24.04 || $(dpkg --print-architecture) != amd64 ]]; then
  echo 'This boot script supports Ubuntu 24.04 on amd64 only; nothing was changed.' >&2
  exit 1
fi

# Writes stdin to $1 with mode $2 only when its content differs; sets changed=1 when it wrote.
write_if_changed() {
  local content staged
  content=$(cat)
  changed=0
  if [[ -f $1 && $(cat "$1") == "$content" ]]; then
    chmod "$2" "$1"
    return 0
  fi
  staged=$(mktemp "$1.XXXXXX")
  printf '%s\n' "$content" >"$staged"
  chmod "$2" "$staged"
  mv -f "$staged" "$1"
  changed=1
}

host_json=$(printf '%s' '${host_config_base64}' | base64 --decode)
install -d -m 0700 /etc/pyracast
write_if_changed /etc/pyracast/host.json 0600 <<<"$host_json"

data_device=/dev/disk/by-id/google-${data_device_name}
for attempt in $(seq 1 90); do
  test ! -b "$data_device" || break
  sleep 1
done
test -b "$data_device"
filesystem=$(blkid -s TYPE -o value "$data_device" || true)
if [[ -z $filesystem ]]; then
  # Only a new disk is formatted: no signature anywhere and a zeroed first MiB.
  if [[ -n $(wipefs --no-act --noheadings --output TYPE "$data_device") ]] \
    || ! cmp --silent --bytes=1048576 "$data_device" /dev/zero; then
    echo 'The data disk has no ext4 filesystem but is not empty; inspect it before continuing.' >&2
    exit 1
  fi
  mkfs.ext4 -F "$data_device"
elif [[ $filesystem != ext4 ]]; then
  echo 'The application data disk must use ext4.' >&2
  exit 1
fi
data_uuid=$(blkid -s UUID -o value "$data_device")
# nofail keeps the VM reachable without the disk; RequiresMountsFor still holds the services.
entry="UUID=$data_uuid /var/lib/pyracast ext4 defaults,nodev,nosuid,nofail 0 2"
mounts_changed=0
if ! grep --quiet --line-regexp --fixed-strings "$entry" /etc/fstab; then
  if awk -v uuid="UUID=$data_uuid" '$2 == "/var/lib/pyracast" && $1 != uuid { found=1 } END { exit !found }' /etc/fstab; then
    echo 'A different data disk is already configured; inspect fstab before continuing.' >&2
    exit 1
  fi
  fstab=$(awk -v uuid="UUID=$data_uuid" '!($1 == uuid && $2 == "/var/lib/pyracast")' /etc/fstab)
  write_if_changed /etc/fstab 0644 <<<"$fstab
$entry"
  mounts_changed=1
fi
install -d -m 0755 /var/lib/pyracast
mountpoint --quiet /var/lib/pyracast || mount /var/lib/pyracast
# Holds the release lock and marker: only root may create or replace entries in it.
install -d -o root -g root -m 0755 /var/lib/pyracast
install -d -o 999 -g 999 -m 0750 /var/lib/pyracast/rabbitmq
install -d -o 70 -g 70 -m 0700 /var/lib/pyracast/postgres
install -d -o 10001 -g 10001 -m 0750 /var/lib/pyracast/gateway
install -d -m 0755 /opt/pyracast/releases

guard=$(printf '%s' '${network_guard_base64}' | base64 --decode)
write_if_changed /usr/local/sbin/pyracast-network-guard 0755 <<<"$guard"
if (( changed )); then /usr/local/sbin/pyracast-network-guard; fi

docker_changed=0
install -d -m 0755 /etc/docker
write_if_changed /etc/docker/daemon.json 0644 <<'EOF'
{
  "log-driver": "local",
  "log-opts": {"max-size": "10m", "max-file": "5"},
  "firewall-backend": "iptables",
  "ipv6": false,
  "live-restore": true
}
EOF
docker_changed=$((docker_changed | changed))

install -d -m 0755 /etc/systemd/system/docker.service.d
write_if_changed /etc/systemd/system/docker.service.d/pyracast-data.conf 0644 <<'EOF'
[Unit]
RequiresMountsFor=/var/lib/pyracast

[Service]
ExecStartPre=/usr/local/sbin/pyracast-network-guard
ExecStartPost=/usr/local/sbin/pyracast-network-guard
EOF
docker_changed=$((docker_changed | changed))

write_if_changed /etc/systemd/system/pyracast.service 0644 <<'EOF'
[Unit]
Description=Pyracast application containers
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service
RequiresMountsFor=/var/lib/pyracast
ConditionPathExists=/opt/pyracast/current/deploy/compose.yaml
ConditionPathExists=!/var/lib/pyracast/release-blocked
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
WorkingDirectory=/opt/pyracast/current
RuntimeDirectory=pyracast
RuntimeDirectoryMode=0700
UMask=0077
ExecStartPre=/usr/local/sbin/pyracast-network-guard
ExecStartPre=/usr/bin/python3 /opt/pyracast/current/deploy/runtime_secrets.py /etc/pyracast/host.json
ExecStart=/usr/bin/docker compose --env-file deploy/release.env -f deploy/compose.yaml up --detach --wait --wait-timeout 180
ExecStop=/usr/bin/flock /var/lib/pyracast/release.lock /usr/bin/docker compose --env-file deploy/release.env -f deploy/compose.yaml stop --timeout 660
TimeoutStartSec=300
TimeoutStopSec=960

[Install]
WantedBy=multi-user.target
EOF
units_changed=$changed

if (( units_changed || docker_changed || mounts_changed )); then systemctl daemon-reload; fi

# Installed once at their pinned versions; a boot that finds them needs no package mirror.
docker_pins='docker-ce=5:29.9.3-1~ubuntu.24.04~noble docker-ce-cli=5:29.9.3-1~ubuntu.24.04~noble containerd.io=2.4.2-2~ubuntu.24.04~noble docker-compose-plugin=5.7.1-1~ubuntu.24.04~noble'
installed_version() {
  dpkg-query --status "$1" 2>/dev/null \
    | awk '/^Status: [a-z]+ ok installed$/ { installed=1 } /^Version: / { version=$2 } END { if (installed) print version }'
}
pinned_packages_installed() {
  local pin
  for pin in $docker_pins; do
    [[ $(installed_version "$(echo "$pin" | cut -d= -f1)") == "$(echo "$pin" | cut -d= -f2-)" ]] || return 1
  done
  for pin in ca-certificates curl iptables python3; do
    [[ -n $(installed_version "$pin") ]] || return 1
  done
}
if ! pinned_packages_installed; then
  apt-get update
  apt-get install --yes --no-install-recommends ca-certificates curl gnupg iptables python3
  install -d -m 0755 /etc/apt/keyrings
  key=$(mktemp)
  curl --fail --silent --show-error --location https://download.docker.com/linux/ubuntu/gpg -o "$key"
  fingerprint=$(gpg --show-keys --with-colons "$key" | awk -F: '$1 == "fpr" { print $10; exit }')
  if [[ $fingerprint != 9DC858229FC7DD38854AE2D88D81803C0EBFCD88 ]]; then
    echo 'The Docker repository key does not have its published fingerprint; nothing was installed.' >&2
    exit 1
  fi
  install -m 0644 "$key" /etc/apt/keyrings/docker.asc
  rm -f -- "$key"
  write_if_changed /etc/apt/sources.list.d/docker.sources 0644 <<'EOF'
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: noble
Components: stable
Architectures: amd64
Signed-By: /etc/apt/keyrings/docker.asc
EOF
  apt-get update
  apt-get install --yes --no-install-recommends --allow-change-held-packages $docker_pins
  apt-mark hold docker-ce docker-ce-cli containerd.io docker-compose-plugin
fi

systemctl enable docker.service pyracast.service
if test -f /opt/pyracast/current/deploy/install-units.sh; then
  bash /opt/pyracast/current/deploy/install-units.sh install /opt/pyracast/current \
    || echo 'The release units were not installed; the previous units stay in place.' >&2
fi
# A Docker restart restarts the application through Requires=; never while a release runs. The
# marker keeps a deferred restart due when the next run finds the configuration unchanged.
if (( docker_changed )); then touch /etc/docker/pyracast-restart-pending; fi
if [[ -e /etc/docker/pyracast-restart-pending ]]; then
  if flock --nonblock /var/lib/pyracast/release.lock true; then
    systemctl restart docker.service
    rm -f /etc/docker/pyracast-restart-pending
  else
    echo 'The Docker configuration changed while the release lock was held; run this script again.' >&2
    exit 1
  fi
fi
if test -f /opt/pyracast/current/deploy/compose.yaml; then
  systemctl start pyracast.service
fi
