# Plant-specific Solcast accounts, API keys and resource IDs are configured in /admin/.
# These credentials belong to shared platform services, not individual plants.
EPIAS_USERNAME=
EPIAS_PASSWORD=
PYRACAST_SECRET_KEY=
PYRACAST_DEBUG=1
PYRACAST_LOG_LEVEL=INFO
PYRACAST_HOSTS=localhost,127.0.0.1
PYRACAST_CSRF_ORIGINS='http://localhost:3000 http://127.0.0.1:3000'
PYRACAST_PUBLIC_ORIGIN=http://127.0.0.1:3000
PYRACAST_GOOGLE_CLIENT_ID=
PYRACAST_GOOGLE_CLIENT_SECRET=
PYRACAST_MICROSOFT_CLIENT_ID=
PYRACAST_MICROSOFT_CLIENT_SECRET=
PYRACAST_TRUST_PROXY=0
PYRACAST_TRUSTED_PROXY_CIDRS=
PYRACAST_TRUSTED_UPSTREAM_PROXY_CIDRS=
PYRACAST_CUTOFF_LOCAL=16:00
PGDATABASE=pyracast
PGUSER=pyracast
# The loopback development helper uses trust; production needs operator-provided authentication.
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
PYRACAST_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F
PYRACAST_EMAIL_BACKEND=console
PYRACAST_EMAIL_HOST=
PYRACAST_EMAIL_PORT=587
PYRACAST_EMAIL_USER=
PYRACAST_EMAIL_PASSWORD=
PYRACAST_EMAIL_TLS=1
PYRACAST_EMAIL_SSL=0
# Gmail OAuth alternative: set PYRACAST_EMAIL_BACKEND=gmail after authorizing gmail.send.
PYRACAST_GMAIL_CLIENT_ID=
PYRACAST_GMAIL_CLIENT_SECRET=
PYRACAST_GMAIL_REFRESH_TOKEN=
PYRACAST_FROM_EMAIL='Pyracast <noreply@localhost>'
